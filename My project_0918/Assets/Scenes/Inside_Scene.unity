  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "2025-2, \uAC8C\uC784\uCE90\uB9AD\uD130\uB514\uC790\uC778\n\n3025\uB144,
    \uCE58\uBA85\uC801\uC778 \uBC14\uC774\uB7EC\uC2A4\uB85C \uC778\uB958\uAC00 \uBA78\uB9DD\uD558\uACE0\n
    \uB3C4\uC2DC\uB294 \uAC70\uB300\uD55C \uC790\uC5F0 \uC0DD\uD0DC\uACC4\uB85C \uBCC0\uD574\uAC04\uB2E4.\r\n\uC218\uB9CE\uC740
    \uC138\uB300\uC5D0 \uAC78\uCE5C \uC9C4\uD654\uB97C \uAC70\uCCD0, \n\uC778\uB958\uB97C
    \uAC00\uC7A5 \uAC00\uAE4C\uC774\uC5D0\uC11C \uC9C0\uCF1C\uBD10 \uC628 \uCC38\uC0C8\uB294\n\uC778\uAC04\uACFC
    \uAC19\uC740 \uC9C0\uC131\uC744 \uC9C0\uB2CC \uC874\uC7AC\uB85C \uAC70\uB4ED\uB09C\uB2E4.\r\n\uADF8\uB4E4\uC740
    \uC790\uC5F0\uC5D0 \uBB3B\uD78C \uC61B \uC778\uB958\uC758 \uBB38\uBA85\uACFC
    \uAE30\uC5B5\uC744 \uB418\uC0B4\uB9AC\uACE0\uC790 \uD55C\uB2E4.\r\n\uADF8\uB9AC\uACE0
    \uC0B4\uC544\uB0A8\uC740 \uC0DD\uBA85\uCCB4\uB4E4\uACFC \uD568\uAED8 \uC0C8\uB85C\uC6B4
    \uBB38\uBA85\uC744 \uB9CC\uB4E4\uC5B4\uAC08 \uBBF8\uB798\uB97C \uAFC8\uAFBC\uB2E4."
