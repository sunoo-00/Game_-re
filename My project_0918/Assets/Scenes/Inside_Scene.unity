  m_text: "2025-2, \uAC8C\uC784UI\uB514\uC790\uC778\n\n\uD070 \uC2AC\uD514\uACFC
    \uBC88\uC544\uC6C3\uC73C\uB85C \uAC10\uC815\uC744 \uC783\uC5B4\uBC84\uB9B0 \uD50C\uB808\uC774\uC5B4\uB294
    \n\uC0C9\uC774 \uC0AC\uB77C\uC9C4 \uD751\uBC31 \uB9C8\uC744\uC5D0 \uB3C4\uCC29\uD55C\uB2E4.
    \n\uB9C8\uC744\uC744 \uD0D0\uC0C9\uD558\uBA70 \uC624\uBE0C\uC81D\uD2B8\uB97C
    \uBCF5\uC6D0\uD558\uACE0 \uC8FC\uBBFC\uB4E4\uACFC \uAD50\uAC10\uD558\uB294 \uACFC\uC815\uC5D0\uC11C\n\uC78A\uD600\uC9C4
    \uAE30\uC5B5\uACFC \uAC10\uC815\uC774 \uB418\uC0B4\uC544\uB098\uACE0, \uB9C8\uC744\uC5D0\uB294
    \uC11C\uC11C\uD788 \uC0C9\uC774 \uB3CC\uC544\uC628\uB2E4. \r\n\r\n\uB9C8\uC744\uC740
    \uD50C\uB808\uC774\uC5B4\uC758 \uB0B4\uBA74 \uC138\uACC4\uB97C \uC0C1\uC9D5\uD558\uBA70,
    \uB9C8\uC744\uC744 \uBCF5\uC6D0\uD558\uB294 \uC5EC\uC815\uC740\n\uC78A\uACE0
    \uC788\uB358 \uC18C\uC911\uD55C \uAE30\uC5B5\uACFC \uAC10\uC815\uC744 \uB2E4\uC2DC
    \uB9C8\uC8FC\uD558\uACE0 \uC0B6\uC758 \uC0C9\uC744 \uB418\uCC3E\uC544\uAC00\uB294
    \n\uC774\uC57C\uAE30\uB97C \uD45C\uD604\uD55C \uC791\uD488\uC785\uB2C8\uB2E4"
